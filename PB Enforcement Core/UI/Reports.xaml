<UserControl x:Class="Advanced_PB_Limiter.UI.Reports"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Advanced_PB_Limiter.UI"
             xmlns:reports="clr-namespace:Advanced_PB_Limiter.Utils.Reports"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" Background="White" >
    
    <UserControl.Resources>
        <!-- ===== PB Enforcement Core :: light theme ===== -->
        <SolidColorBrush x:Key="TextBrush" Color="#FF1F2937"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#FF6B7280"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF4338CA"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFF7F8FA"/>
        <SolidColorBrush x:Key="EdgeBrush" Color="#FFE1E4EA"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FFDC2626"/>

        <Style TargetType="{x:Type TabControl}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Margin="0,0,0,6"/>
                            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource EdgeBrush}" BorderThickness="0,1,0,0">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="14,8,14,8">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"/>
                                        <Setter Property="FontSize" Value="14"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="{x:Type Label}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="{x:Type GroupBox}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}"/>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}"/>
        </Style>

        <ControlTemplate x:Key="CoreButtonTemplate" TargetType="{x:Type Button}">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}">
                    <ContentPresenter.Resources>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                        </Style>
                    </ContentPresenter.Resources>
                </ContentPresenter>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.72"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="{x:Type Button}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="10,4,10,4"/>
            <Setter Property="Template" Value="{StaticResource CoreButtonTemplate}"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource EdgeBrush}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="6,6"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        
        
        

    </UserControl.Resources>
    
    <!-- A grid, not a stack: the two tables share the height of the tab and scroll by themselves. A stack panel gave
         them unlimited height, so rows below the window edge (and the whole Per Player table) could not be reached. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="*" MinHeight="120"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0">
            <GroupBox.Header>
                <TextBlock>
                    <Span FontWeight="Bold">Live Report Settings</Span>
                </TextBlock>
            </GroupBox.Header>
            <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <Button Name="EnableLiveViewButton" Content="Enable Live View" ToolTip="Always disabled after restarts (default)" Margin="3" Click="EnableLiveViewButton_OnClick"/>
                    <Button Name="DisableLiveViewButton" Content="Disable Live View" ToolTip="Although this isn't a costly procedure, you are running a Space Engineers server after all..." Margin="3" Click="DisableLiveViewButton_OnClick"/>
                    <Button Name="ManualUpdateButton" Content="Manually Update" ToolTip="Refreshes the live view" Margin="3" Click="ManualUpdateButton_OnClick"/>
                    <Button Name="GenerateTextReport" Content="Regenerate Data and Save To File" ToolTip="Generates a new report and saves to file" Margin="3" Click="GenerateTextReport_OnClick"/>
                    <Button Name="SaveCurrentReport" Content="Save Current Report To File" ToolTip="Saves current report to file" Margin="3" Click="SaveCurrentReport_OnClick"/>
                    <Rectangle Height="20" Width="3" Fill="{StaticResource EdgeBrush}" Margin="3"/>
                    <TextBlock Text="Refresh Rate: " Margin="3" ToolTip="In seconds, how often the live reporting updates (0.25 to 60)." VerticalAlignment="Center"/>
                    <TextBox Name="RefreshRateTextBox" Text="0.5" Width="36" Margin="3" ToolTip="In seconds, how often the live reporting updates (0.25 to 60).  You will need to stop and restart live reporting for changes to take effect." VerticalAlignment="Center" TextAlignment="Center"/>
                </WrapPanel>
                <TextBlock Name="LiveStatusText" Margin="3,2,3,2" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           Text="The live view is off. Press Enable Live View, or Manually Update for a single refresh."/>
            </StackPanel>
        </GroupBox>
        
        <GroupBox Grid.Row="1">
            <GroupBox.Header>
                <TextBlock>
                    <Span FontWeight="Bold">Per Programming Block</Span>
                </TextBlock>
            </GroupBox.Header>
            <DataGrid Name="PerPBDataGrid" AutoGenerateColumns="False" SelectionMode="Single" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" EnableRowVirtualization="True"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      d:DataContext="{d:DesignInstance Type=reports:CustomBlockReport}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Player SteamID" Binding="{Binding SteamId}"/>
                    <DataGridTextColumn Header="Player Name" Binding="{Binding PlayerName}"/>
                    <DataGridTextColumn Header="Grid Name" Binding="{Binding GridName}"/>
                    <DataGridTextColumn Header="Block Name" Binding="{Binding BlockName}"/>
                    <DataGridTextColumn Header="Last MS" Binding="{Binding LastRunTimeMS, StringFormat={}{0:0.######}}"/>
                    <DataGridTextColumn Header="Avg MS" Binding="{Binding AvgMS, StringFormat={}{0:0.######}}"/>
                    <DataGridTextColumn Header="Peek MS" Binding="{Binding PeekRunTimeMS, StringFormat={}{0:0.######}}"/>
                    <DataGridTextColumn Header="Offenses" Binding="{Binding Offences}"/>
                    <DataGridTextColumn Header="Recompiles" Binding="{Binding Recompiles}"/>
                    <DataGridTextColumn Header="Memory" Binding="{Binding MemoryUsed}"/>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Turn Off" Tag="{Binding pbBlock}" PreviewMouseUp="TurnOff_PB"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        
        <GroupBox Grid.Row="2">
            <GroupBox.Header>
                <TextBlock>
                    <Span FontWeight="Bold">Per Player</Span>
                </TextBlock>
            </GroupBox.Header>
            <DataGrid Name="PerPlayerDataGrid" AutoGenerateColumns="False" SelectionMode="Single" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" EnableRowVirtualization="True"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      d:DataContext="{d:DesignInstance Type=reports:CustomPlayerReport}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Player SteamID" Binding="{Binding SteamId}"/>
                    <DataGridTextColumn Header="Player Name" Binding="{Binding PlayerName}"/>
                    <DataGridTextColumn Header="Combined MS" Binding="{Binding CombinedLastRunTimeMS, StringFormat={}{0:0.####}}"/>
                    <DataGridTextColumn Header="Combined Avg MS" Binding="{Binding CombinedAvgMS, StringFormat={}{0:0.####}}"/>
                    <DataGridTextColumn Header="Offenses" Binding="{Binding Offences}"/>
                    <DataGridTextColumn Header="PB's Tracked" Binding="{Binding PbCount}"/>
                    <DataGridTextColumn Header="Recompiles" Binding="{Binding Recompiles}"/>
                    <DataGridTextColumn Header="Memory" Binding="{Binding MemoryUsed}"/>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Turn All Off" Tag="{Binding PlayerTracked}" PreviewMouseUp="TurnOff_AllPB"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
        
    </Grid>
    
</UserControl>
